@page "/reports"
@inject IBIRReportService BIRReportService

<div class="content-header px-0 pt-0">
    <div class="row align-items-center">
        <div class="col">
            <div class="page-kicker">Compliance reports</div>
            <h1 class="page-title mb-0">BIR Reports</h1>
        </div>
        <div class="col-auto">
            <button type="button" class="btn btn-outline-primary" onclick="window.print()">
                <i class="fas fa-print mr-1"></i> Print
            </button>
        </div>
    </div>
</div>

@if (zReading is null)
{
    <div class="card">
        <div class="card-body">
            <i class="fas fa-circle-notch fa-spin mr-2"></i> Preparing report...
        </div>
    </div>
}
else
{
    <div class="row">
        <div class="col-lg-8 mb-3">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title mb-0">Z-Reading Preview</h3>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <dl class="row mb-0">
                                <dt class="col-sm-5">Branch</dt>
                                <dd class="col-sm-7">@zReading.BranchName</dd>
                                <dt class="col-sm-5">Terminal</dt>
                                <dd class="col-sm-7">@zReading.TerminalCode</dd>
                                <dt class="col-sm-5">Business Date</dt>
                                <dd class="col-sm-7">@zReading.BusinessDate.ToString("MMM d, yyyy")</dd>
                            </dl>
                        </div>
                        <div class="col-md-6">
                            <dl class="row mb-0">
                                <dt class="col-sm-5">Beginning SI</dt>
                                <dd class="col-sm-7">@zReading.BeginningInvoiceNumber</dd>
                                <dt class="col-sm-5">Ending SI</dt>
                                <dd class="col-sm-7">@zReading.EndingInvoiceNumber</dd>
                                <dt class="col-sm-5">Transactions</dt>
                                <dd class="col-sm-7">@zReading.TransactionCount</dd>
                            </dl>
                        </div>
                    </div>

                    <hr />

                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <tbody>
                                <tr>
                                    <th>Gross Sales</th>
                                    <td class="text-right">@Money(zReading.GrossSales)</td>
                                </tr>
                                <tr>
                                    <th>Discounts</th>
                                    <td class="text-right">@Money(zReading.DiscountTotal)</td>
                                </tr>
                                <tr>
                                    <th>VATable Sales</th>
                                    <td class="text-right">@Money(zReading.VatSales)</td>
                                </tr>
                                <tr>
                                    <th>VAT Amount</th>
                                    <td class="text-right">@Money(zReading.VatAmount)</td>
                                </tr>
                                <tr>
                                    <th>Void Total</th>
                                    <td class="text-right">@Money(zReading.VoidTotal)</td>
                                </tr>
                                <tr>
                                    <th>Refund Total</th>
                                    <td class="text-right">@Money(zReading.RefundTotal)</td>
                                </tr>
                                <tr class="font-weight-bold">
                                    <th>Net Sales</th>
                                    <td class="text-right">@Money(zReading.NetSales)</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4 mb-3">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title mb-0">Compliance Direction</h3>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled mb-0">
                        <li class="mb-2"><i class="fas fa-lock text-pos-primary mr-2"></i> Sales are retained after posting.</li>
                        <li class="mb-2"><i class="fas fa-sort-numeric-up text-pos-primary mr-2"></i> Invoice numbers come from a terminal series.</li>
                        <li class="mb-2"><i class="fas fa-undo text-pos-primary mr-2"></i> Voids and refunds will be reversal flows.</li>
                        <li><i class="fas fa-history text-pos-primary mr-2"></i> Sensitive changes are audit logged.</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private ZReadingDto? zReading;

    protected override async Task OnInitializedAsync()
    {
        zReading = await BIRReportService.GetTodayZReadingAsync();
    }

    private static string Money(decimal value) => $"PHP {value:N2}";
}
