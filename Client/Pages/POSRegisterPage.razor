@page "/pos"
@inject IPOSService POSService
@inject NavigationManager NavigationManager

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert @messageClass counter-alert">@message</div>
}

@if (catalog is null)
{
    <div class="counter-loading">
        <i class="fas fa-circle-notch fa-spin"></i>
        <span>Loading register...</span>
    </div>
}
else
{
    <div class="pos-workspace">
        <section class="pos-catalog-panel">
            <div class="drawer-alert @(IsShiftOpen ? "drawer-alert-open" : null)">
                <div class="drawer-alert-icon">
                    <i class="fas @(IsShiftOpen ? "fa-lock-open" : "fa-lock")"></i>
                </div>
                <div>
                    <strong>@(IsShiftOpen ? "Shift is open" : "No shift started")</strong>
                    <span>@(IsShiftOpen ? $"{catalog.RegisterState.CashierName} is assigned to {catalog.RegisterState.TerminalCode}." : "Open your cash drawer with a starting float before taking sales.")</span>
                </div>
                <button type="button" class="btn btn-counter-primary ml-auto" @onclick="NavigateToCashMovements">
                    <i class="fas fa-cash-register mr-2"></i>@(IsShiftOpen ? "Cash Movements" : "Open Drawer")
                </button>
            </div>

            <div class="pos-search-row">
                <div class="counter-search flex-grow-1">
                    <i class="fas fa-search"></i>
                    <input @bind="search" @bind:event="oninput" placeholder="Search name / SKU / barcode... (F2, Enter)" />
                    <i class="fas fa-barcode search-action"></i>
                </div>

                <select class="counter-select" @bind="selectedCategoryName">
                    <option value="@AllCategories">All Categories</option>
                    @foreach (var category in catalog.Categories)
                    {
                        <option value="@category.Name">@category.Name</option>
                    }
                </select>

                <button type="button" class="btn btn-counter-light icon-button" title="Scan barcode">
                    <i class="fas fa-keyboard"></i>
                </button>
            </div>

            <div class="counter-tabs">
                @foreach (var tab in tabs)
                {
                    <button type="button" class="@(activeTab == tab.Key ? "active" : null)" @onclick="() => activeTab = tab.Key">
                        <i class="@tab.Icon"></i>
                        <span>@tab.Label</span>
                    </button>
                }
            </div>

            <div class="counter-product-grid">
                @foreach (var product in FilteredProducts)
                {
                    <button type="button" class="counter-product-card" @onclick="() => AddToCart(product)">
                        <div class="product-image-placeholder">
                            <i class="fas fa-shopping-cart"></i>
                        </div>
                        <div class="product-card-body">
                            <div class="product-card-name">@product.Name</div>
                            <div class="product-card-sku">@product.Sku</div>
                            <div class="product-card-footer">
                                <strong>@Money(product.Price)</strong>
                                <span class="@StockPillClass(product)">@product.QuantityOnHand.ToString("N0")</span>
                            </div>
                        </div>
                    </button>
                }
            </div>
        </section>

        <aside class="pos-cart-panel">
            <div class="cart-panel-header">
                <h2><i class="fas fa-shopping-cart mr-2"></i>Current Sale</h2>
            </div>

            <select class="counter-select w-100 mb-3" @bind="customerName">
                <option value="">Walk-in Customer</option>
                <option value="Regular Customer">Regular Customer</option>
                <option value="Wholesale Account">Wholesale Account</option>
            </select>

            <div class="cart-lines">
                @if (!cart.Any())
                {
                    <div class="empty-cart-state">
                        <i class="fas fa-shopping-cart"></i>
                        <strong>Cart is empty</strong>
                        <span>Click a product or scan a barcode.</span>
                    </div>
                }
                else
                {
                    @foreach (var line in cart)
                    {
                        <div class="counter-cart-line">
                            <div>
                                <strong>@line.Product.Name</strong>
                                <span>@Money(line.Product.Price) each</span>
                            </div>
                            <div class="cart-line-total">@Money(line.LineTotal)</div>
                            <div class="quantity-stepper">
                                <button type="button" @onclick="() => ChangeQuantity(line, -1)">-</button>
                                <span>@line.Quantity.ToString("N0")</span>
                                <button type="button" @onclick="() => ChangeQuantity(line, 1)">+</button>
                            </div>
                        </div>
                    }
                }
            </div>

            <div class="cart-summary">
                <div class="summary-row">
                    <span>Subtotal (@cart.Count item@(cart.Count == 1 ? string.Empty : "s"))</span>
                    <strong>@Money(Subtotal)</strong>
                </div>
                <div class="summary-row">
                    <span>Tax</span>
                    <strong>@Money(TaxEstimate)</strong>
                </div>
                <div class="discount-row">
                    <span>%</span>
                    <input type="number" min="0" step="0.01" @bind="manualDiscount" placeholder="Order discount" />
                </div>

                @if (cart.Any())
                {
                    <div class="discount-row">
                        <span><i class="fas fa-money-bill-wave"></i></span>
                        <input type="number" min="0" step="0.01" @bind="amountTendered" placeholder="Amount tendered" />
                    </div>
                }

                <div class="total-row">
                    <span>Total</span>
                    <strong>@Money(NetTotal)</strong>
                </div>

                <div class="cart-actions">
                    <button type="button" class="btn btn-counter-light" disabled="@(!cart.Any())">
                        <i class="far fa-pause-circle mr-2"></i>Hold
                    </button>
                    <button type="button" class="btn btn-counter-primary" @onclick="CheckoutAsync" disabled="@(!CanCheckout)">
                        <i class="far fa-credit-card mr-2"></i>Pay
                    </button>
                </div>
                <button type="button" class="park-button" disabled="@(!cart.Any())">
                    <i class="far fa-clock mr-2"></i>Park Transaction
                </button>
            </div>
        </aside>
    </div>
}

@code {
    private const string AllCategories = "All Categories";

    private readonly (string Key, string Label, string Icon)[] tabs =
    [
        ("All", "All", "fas fa-th"),
        ("Favorites", "Favorites", "far fa-star"),
        ("Recent", "Recent", "far fa-clock")
    ];

    private PosCatalogDto? catalog;
    private readonly List<CartLine> cart = [];
    private string selectedCategoryName = AllCategories;
    private string activeTab = "All";
    private string search = string.Empty;
    private string orderType = "Retail";
    private string? customerName;
    private string paymentMethod = "Cash";
    private decimal manualDiscount;
    private decimal amountTendered;
    private string? message;
    private string messageClass = "alert-info";

    private bool IsShiftOpen =>
        catalog?.RegisterState.CashierName is { Length: > 0 } cashier &&
        !cashier.Equals("No open shift", StringComparison.OrdinalIgnoreCase);

    private IEnumerable<ProductDto> FilteredProducts
    {
        get
        {
            var products = catalog?.Products.AsEnumerable() ?? [];

            if (selectedCategoryName != AllCategories)
            {
                products = products.Where(product => product.CategoryName == selectedCategoryName);
            }

            if (!string.IsNullOrWhiteSpace(search))
            {
                products = products.Where(product =>
                    product.Name.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                    product.Sku.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                    product.Barcode.Contains(search, StringComparison.OrdinalIgnoreCase));
            }

            products = activeTab switch
            {
                "Favorites" => products.Where(IsFavoriteProduct),
                "Recent" => products.Reverse().Take(8),
                _ => products
            };

            return products;
        }
    }

    private decimal Subtotal => cart.Sum(line => line.LineTotal);
    private decimal NetTotal => Math.Max(0, Subtotal - manualDiscount);
    private decimal TaxEstimate
    {
        get
        {
            var rate = catalog?.RegisterState.VatRate ?? 0.12m;
            return NetTotal <= 0 ? 0 : Math.Round(NetTotal * rate / (1 + rate), 2);
        }
    }
    private bool CanCheckout => cart.Any() && amountTendered >= NetTotal && NetTotal > 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadCatalogAsync();
    }

    private async Task LoadCatalogAsync()
    {
        catalog = await POSService.GetCatalogAsync();
    }

    private void AddToCart(ProductDto product)
    {
        var existing = cart.FirstOrDefault(line => line.Product.Id == product.Id);
        if (existing is null)
        {
            cart.Add(new CartLine(product));
        }
        else
        {
            existing.Quantity++;
        }

        amountTendered = NetTotal;
    }

    private void ChangeQuantity(CartLine line, int delta)
    {
        line.Quantity += delta;
        if (line.Quantity <= 0)
        {
            cart.Remove(line);
        }

        amountTendered = NetTotal;
    }

    private void ClearCart()
    {
        cart.Clear();
        manualDiscount = 0;
        amountTendered = 0;
        customerName = null;
    }

    private async Task CheckoutAsync()
    {
        message = null;

        var request = new CreateSaleRequest(
            cart.Select(line => new CartLineRequest(line.Product.Id, line.Quantity, line.Product.Price, 0)).ToList(),
            [new PaymentRequest(paymentMethod, amountTendered, null)],
            manualDiscount,
            customerName,
            orderType,
            null);

        var response = await POSService.CreateSaleAsync(request);
        if (!response.IsSuccessStatusCode)
        {
            messageClass = "alert-danger";
            message = await response.Content.ReadAsStringAsync();
            return;
        }

        var result = await response.Content.ReadFromJsonAsync<CreateSaleResponse>();
        messageClass = "alert-success";
        message = $"Sale {result?.InvoiceNumber} completed. Change due: {Money(result?.ChangeDue ?? 0)}.";
        ClearCart();
        await LoadCatalogAsync();
    }

    private static string Money(decimal value) => $"PHP {value:N2}";

    private static string StockPillClass(ProductDto product) =>
        product.QuantityOnHand <= product.ReorderPoint ? "stock-pill stock-low" : "stock-pill";

    private void NavigateToCashMovements()
    {
        NavigationManager.NavigateTo("cash-movements");
    }

    private static bool IsFavoriteProduct(ProductDto product) =>
        product.Sku.StartsWith("COF-", StringComparison.OrdinalIgnoreCase) ||
        product.Sku.StartsWith("PAS-", StringComparison.OrdinalIgnoreCase) ||
        product.CategoryName.Contains("Coffee", StringComparison.OrdinalIgnoreCase) ||
        product.CategoryName.Contains("Pastries", StringComparison.OrdinalIgnoreCase);

    private sealed class CartLine(ProductDto product)
    {
        public ProductDto Product { get; } = product;
        public decimal Quantity { get; set; } = 1;
        public decimal LineTotal => Product.Price * Quantity;
    }
}
