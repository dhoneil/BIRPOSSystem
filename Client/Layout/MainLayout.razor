@inherits LayoutComponentBase

<div class="wrapper birpos-shell">
    <nav class="main-header navbar navbar-expand navbar-white navbar-light border-bottom-0">
        <ul class="navbar-nav">
            <li class="nav-item">
                <a class="nav-link" data-widget="pushmenu" href="#" role="button" aria-label="Toggle navigation">
                    <i class="fas fa-bars"></i>
                </a>
            </li>
            <li class="nav-item d-none d-sm-inline-block">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All">Dashboard</NavLink>
            </li>
            <li class="nav-item d-none d-sm-inline-block">
                <NavLink class="nav-link font-weight-semibold text-pos-primary" href="pos">Open Register</NavLink>
            </li>
        </ul>

        <ul class="navbar-nav ml-auto align-items-center">
            <li class="nav-item mr-2">
                <span class="badge badge-soft-success">Local-first</span>
            </li>
            <AuthorizeView>
                <Authorized>
                    <li class="nav-item dropdown">
                        <a class="nav-link" data-toggle="dropdown" href="#" aria-label="Account menu">
                            <i class="far fa-user-circle mr-1"></i>
                            @context.User.Identity?.Name
                        </a>
                        <div class="dropdown-menu dropdown-menu-right">
                            <NavLink class="dropdown-item" href="Account/Manage">
                                <i class="fas fa-user-cog mr-2"></i> Account
                            </NavLink>
                        </div>
                    </li>
                </Authorized>
                <NotAuthorized>
                    <li class="nav-item">
                        <NavLink class="btn btn-sm btn-outline-primary" href="Account/Login">
                            <i class="fas fa-sign-in-alt mr-1"></i> Login
                        </NavLink>
                    </li>
                </NotAuthorized>
            </AuthorizeView>
        </ul>
    </nav>

    <NavMenu />

    <main class="content-wrapper">
        <section class="content pt-3 pb-4">
            <div class="container-fluid">
                @Body
            </div>
        </section>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">x</span>
</div>
