@inherits LayoutComponentBase

<main class="login-layout">
    <section class="login-content" aria-label="Account access">
        <div class="login-card">
            @Body
        </div>
    </section>

    <section class="login-brand-panel" aria-label="BIR POS System">
        <div class="login-brand-top">
            <div class="login-brand-mark">BP</div>
            <div>
                <div class="login-brand-title">BIR POS System</div>
                <div class="login-brand-subtitle">Enterprise retail operations suite</div>
            </div>
        </div>

        <div class="login-brand-copy">
            <div class="login-eyebrow">Local-first POS platform</div>
            <h1>Reliable store operations, from counter to compliance.</h1>
            <p>Secure access for owners, managers, cashiers, inventory teams, auditors, and platform developers.</p>
        </div>

        <div class="login-trust-grid">
            <div>
                <span>Tenant</span>
                <strong>Subscription Ready</strong>
            </div>
            <div>
                <span>Mode</span>
                <strong>Offline Capable</strong>
            </div>
            <div>
                <span>Reports</span>
                <strong>BIR Focused</strong>
            </div>
        </div>
    </section>
</main>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">x</span>
</div>
